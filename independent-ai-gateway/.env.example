PORT=3090
NODE_ENV=production
NETWATCH_AI_SERVICE_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SERVICE_TOKEN
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_KEY_FILE=/run/secrets/groq_api_key
GROQ_TIMEOUT_MS=20000
REQUESTS_PER_MINUTE=60
SESSION_IDLE_MIN=15
SESSION_MAX_MIN=60
MAX_SESSION_REQUESTS=40
SQL_MAX_ROWS=100
