NODE_ENV=production
PORT=3000
TZ=Asia/Kolkata
ADMIN_USER=admin@example.com
ADMIN_PASS=CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_HOURS=8
CORS_ORIGIN=http://192.168.111.22:8888

DB_HOST=postgres
DB_PORT=5432
DB_NAME=netwatch
DB_USER=netwatch
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_DATABASE_PASSWORD
DB_SSL=false
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SEC=120
DB_QUERY_TIMEOUT_MS=60000

AI_ENABLED=true
AI_GATEWAY_URL=http://independent-ai-gateway:3090
NETWATCH_AI_SERVICE_TOKEN=CHANGE_ME_TO_MATCH_THE_GATEWAY_SERVICE_TOKEN
AI_GATEWAY_TIMEOUT_MS=20000
AI_SQL_TIMEOUT_MS=5000
AI_SQL_LOCK_TIMEOUT_MS=1000
AI_SQL_MAX_ROWS=100

POSTFIX_RELAY=172.17.0.1:25
MAIL_FROM=netwatch@example.com
PRUNE_DAYS=60
